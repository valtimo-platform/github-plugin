# Copy to .env.properties. Read by gradle/environment.gradle.kts and handed to bootRun, so
# the sandbox can talk to real GitHub without a token being committed anywhere.
#
# The sandbox has no mock: GitHub's API is large enough that a fake of it would be a second
# thing to keep true, and a token scoped to one throwaway repository is cheaper than that.

# A personal access token. The read-only actions need `public_repo`; the write actions need
# `repo`. Whatever this token may do, every process in the sandbox may do.
GITHUB_TOKEN=ghp_replace_me

# The repository the autodeployed sandbox configuration works in. Point it at a throwaway
# one of your own: the fixtures create issues, branches and pull requests in it.
GITHUB_REPOSITORY=your-org/your-sandbox-repo
