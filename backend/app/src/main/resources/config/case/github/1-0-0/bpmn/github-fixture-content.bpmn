      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="showDirectory_di" bpmnElement="showDirectory">
        <dc:Bounds x="1666" y="90" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="deleteBranch_di" bpmnElement="deleteBranch">
        <dc:Bounds x="1866" y="90" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="showBranchDeleted_di" bpmnElement="showBranchDeleted">
        <dc:Bounds x="2066" y="90" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="2266" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="216" y="130" />
