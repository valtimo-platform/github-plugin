<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_github-fixture-issue" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="github-fixture-issue" name="GitHub fixture: issues" processType="None" isClosed="false" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="createLabel" name="Label aanmaken">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="showLabel" name="Toon resultaat: label">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="createIssue" name="Issue aanmaken">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="showIssue" name="Toon resultaat: issue">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="commentOnIssue" name="Reageren op issue">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="showIssueComment" name="Toon resultaat: reactie">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="getIssue" name="Issue ophalen">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="showIssueDetail" name="Toon resultaat: issue met reacties">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="listIssues" name="Issues opsommen">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="showIssues" name="Toon resultaat: issues">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="searchIssues" name="Issues zoeken">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="showSearchResults" name="Toon resultaat: zoekopdracht">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="updateIssue" name="Issue bijwerken en sluiten">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="showIssueClosed" name="Toon resultaat: gesloten issue">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_1" name="Einde">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="createLabel" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="createLabel" targetRef="showLabel" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="showLabel" targetRef="createIssue" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="createIssue" targetRef="showIssue" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="showIssue" targetRef="commentOnIssue" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="commentOnIssue" targetRef="showIssueComment" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="showIssueComment" targetRef="getIssue" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="getIssue" targetRef="showIssueDetail" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="showIssueDetail" targetRef="listIssues" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="listIssues" targetRef="showIssues" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="showIssues" targetRef="searchIssues" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="searchIssues" targetRef="showSearchResults" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="showSearchResults" targetRef="updateIssue" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="updateIssue" targetRef="showIssueClosed" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="showIssueClosed" targetRef="EndEvent_1" />
  </bpmn:process>
