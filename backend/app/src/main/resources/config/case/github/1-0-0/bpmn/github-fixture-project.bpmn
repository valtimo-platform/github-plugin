<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_github-fixture-project" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="github-fixture-project" name="GitHub fixture: projectborden" processType="None" isClosed="false" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="getProjectItems" name="Projectitems ophalen">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="showProjectItems" name="Toon resultaat: projectitems">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="writeFieldSplit" name="Veld schrijven?" default="Flow_7">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="setProjectItemField" name="Projectveld instellen">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="showProjectField" name="Toon resultaat: ingesteld veld">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="writeFieldJoin">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_1" name="Einde">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="getProjectItems" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="getProjectItems" targetRef="showProjectItems" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="showProjectItems" targetRef="writeFieldSplit" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="setProjectItemField" targetRef="showProjectField" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="writeFieldSplit" targetRef="setProjectItemField" name="ja">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${valueResolverDelegateService.resolveValue(execution, &quot;doc:/writeProjectField&quot;) == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="showProjectField" targetRef="writeFieldJoin" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="writeFieldSplit" targetRef="writeFieldJoin" name="nee" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="writeFieldJoin" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_github-fixture-project">
    <bpmndi:BPMNPlane id="BPMNPlane_github-fixture-project" bpmnElement="github-fixture-project">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="180" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="getProjectItems_di" bpmnElement="getProjectItems">
        <dc:Bounds x="266" y="90" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="showProjectItems_di" bpmnElement="showProjectItems">
        <dc:Bounds x="466" y="90" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="writeFieldSplit_di" bpmnElement="writeFieldSplit">
        <dc:Bounds x="666" y="105" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="setProjectItemField_di" bpmnElement="setProjectItemField">
        <dc:Bounds x="766" y="230" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="showProjectField_di" bpmnElement="showProjectField">
        <dc:Bounds x="966" y="230" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="writeFieldJoin_di" bpmnElement="writeFieldJoin">
        <dc:Bounds x="1166" y="105" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1266" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="216" y="130" />
        <di:waypoint x="266" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="416" y="130" />
        <di:waypoint x="466" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="616" y="130" />
        <di:waypoint x="666" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="916" y="270" />
        <di:waypoint x="966" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="716" y="130" />
        <di:waypoint x="766" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1116" y="270" />
        <di:waypoint x="1166" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="716" y="130" />
        <di:waypoint x="1166" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1216" y="130" />
        <di:waypoint x="1266" y="130" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
