<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_github-fixture-api" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="github-fixture-api" name="GitHub fixture: REST en GraphQL" processType="None" isClosed="false" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="restRequest" name="REST-aanvraag">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="showRestResponse" name="Toon resultaat: REST-antwoord">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="graphqlQuery" name="GraphQL-query">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="showGraphqlResponse" name="Toon resultaat: GraphQL-antwoord">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_1" name="Einde">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="restRequest" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="restRequest" targetRef="showRestResponse" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="showRestResponse" targetRef="graphqlQuery" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="graphqlQuery" targetRef="showGraphqlResponse" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="showGraphqlResponse" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_github-fixture-api">
    <bpmndi:BPMNPlane id="BPMNPlane_github-fixture-api" bpmnElement="github-fixture-api">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="180" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="restRequest_di" bpmnElement="restRequest">
        <dc:Bounds x="266" y="90" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="showRestResponse_di" bpmnElement="showRestResponse">
        <dc:Bounds x="466" y="90" width="150" height="80" />
