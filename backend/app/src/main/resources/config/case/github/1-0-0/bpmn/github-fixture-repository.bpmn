<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_github-fixture-repository" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="github-fixture-repository" name="GitHub fixture: repository" processType="None" isClosed="false" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="getAuthenticatedUser" name="Ingelogde gebruiker ophalen">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="showAuthenticatedUser" name="Toon resultaat: ingelogde gebruiker">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="getRepository" name="Repository ophalen">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="showRepository" name="Toon resultaat: repository">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="listRepositories" name="Repositories opsommen">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="showRepositories" name="Toon resultaat: repositories">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_1" name="Einde">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="getAuthenticatedUser" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="getAuthenticatedUser" targetRef="showAuthenticatedUser" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="showAuthenticatedUser" targetRef="getRepository" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="getRepository" targetRef="showRepository" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="showRepository" targetRef="listRepositories" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="listRepositories" targetRef="showRepositories" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="showRepositories" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_github-fixture-repository">
    <bpmndi:BPMNPlane id="BPMNPlane_github-fixture-repository" bpmnElement="github-fixture-repository">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="180" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="getAuthenticatedUser_di" bpmnElement="getAuthenticatedUser">
        <dc:Bounds x="266" y="90" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="showAuthenticatedUser_di" bpmnElement="showAuthenticatedUser">
        <dc:Bounds x="466" y="90" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="getRepository_di" bpmnElement="getRepository">
        <dc:Bounds x="666" y="90" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="showRepository_di" bpmnElement="showRepository">
        <dc:Bounds x="866" y="90" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="listRepositories_di" bpmnElement="listRepositories">
        <dc:Bounds x="1066" y="90" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="showRepositories_di" bpmnElement="showRepositories">
        <dc:Bounds x="1266" y="90" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1466" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="216" y="130" />
        <di:waypoint x="266" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="416" y="130" />
        <di:waypoint x="466" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="616" y="130" />
        <di:waypoint x="666" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="816" y="130" />
        <di:waypoint x="866" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
