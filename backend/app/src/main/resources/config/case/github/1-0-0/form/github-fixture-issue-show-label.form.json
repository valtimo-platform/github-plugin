{
    "display": "form",
    "components": [
        {
            "key": "pv.label",
            "type": "hidden",
            "input": true,
            "label": "label",
            "tableView": false,
            "persistent": false
        },
        {
            "key": "toelichting",
            "type": "content",
            "input": false,
            "label": "Toelichting",
            "tableView": false,
            "html": "<h4>Create label</h4><p>The answer as the plugin stored it, in process variable <code>label</code>.</p>"
        },
        {
            "key": "pv.weergave",
            "type": "textarea",
            "input": true,
            "tableView": false,
            "label": "Create label",
            "disabled": true,
            "rows": 20,
            "autoExpand": false,
            "calculateValue": "var d = data || {}; var v = d['pv:label']; if (v === undefined && d.pv) { v = d.pv['label']; } value = (v === undefined || v === null) ? '(geen data)' : (typeof v === 'string' ? v : JSON.stringify(v, null, 4));",
            "persistent": false
        },
        {
            "key": "submit",
            "type": "button",
            "input": true,
            "tableView": false,
            "label": "Volgende",
            "disableOnInvalid": true
        }
    ]
}
