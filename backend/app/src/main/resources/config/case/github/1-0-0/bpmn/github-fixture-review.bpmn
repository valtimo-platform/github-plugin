      <bpmndi:BPMNShape id="replyToReviewComment_di" bpmnElement="replyToReviewComment">
        <dc:Bounds x="1166" y="230" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="showReviewReply_di" bpmnElement="showReviewReply">
        <dc:Bounds x="1366" y="230" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="resolveReviewThread_di" bpmnElement="resolveReviewThread">
        <dc:Bounds x="1566" y="230" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="showThreadResolved_di" bpmnElement="showThreadResolved">
        <dc:Bounds x="1766" y="230" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="answerThreadJoin_di" bpmnElement="answerThreadJoin">
        <dc:Bounds x="1966" y="105" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="askReviewersSplit_di" bpmnElement="askReviewersSplit">
        <dc:Bounds x="2066" y="105" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="requestReviewers_di" bpmnElement="requestReviewers">
        <dc:Bounds x="2166" y="230" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="showReviewersRequested_di" bpmnElement="showReviewersRequested">
        <dc:Bounds x="2366" y="230" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="askReviewersJoin_di" bpmnElement="askReviewersJoin">
        <dc:Bounds x="2566" y="105" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reviewPullRequest_di" bpmnElement="reviewPullRequest">
        <dc:Bounds x="2666" y="90" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="showReview_di" bpmnElement="showReview">
        <dc:Bounds x="2866" y="90" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="3066" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
